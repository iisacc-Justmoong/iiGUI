set(_iigui_font_manifest "${CMAKE_CURRENT_SOURCE_DIR}/resources/lvrs-native-appearance.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_iigui_font_manifest}")
file(READ "${_iigui_font_manifest}" _iigui_font_data)
string(JSON _iigui_font_count LENGTH "${_iigui_font_data}" fonts)
math(EXPR _iigui_font_last "${_iigui_font_count}-1")
set(iiGUI_NATIVE_RESOURCE_FILES)
set(_iigui_font_header "#pragma once\n#include <iiGUI/FontDatabase.h>\n#include <array>\nnamespace ii::gui::detail {\ninline constexpr std::array<FontResource,${_iigui_font_count}> font_assets{{\n")
foreach(_index RANGE 0 ${_iigui_font_last})
    foreach(_field file family style weight sha256)
        string(JSON _font_${_field} GET "${_iigui_font_data}" fonts ${_index} ${_field})
    endforeach()
    if(NOT _font_file MATCHES "^[A-Za-z0-9_-]+\\.ttf$" OR NOT _font_family MATCHES "^[A-Za-z0-9 _-]+$" OR NOT _font_style MATCHES "^[A-Za-z0-9 _-]+$" OR NOT _font_weight MATCHES "^[0-9]+$")
        message(FATAL_ERROR "Invalid native font resource metadata")
    endif()
    file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/resources/native/${_font_file}" _font_actual)
    if(NOT _font_actual STREQUAL _font_sha256)
        message(FATAL_ERROR "Native font resource changed: ${_font_file}")
    endif()
    list(APPEND iiGUI_NATIVE_RESOURCE_FILES "${_font_file}")
    string(APPEND _iigui_font_header "    {\"${_font_file}\",\"${_font_family}\",\"${_font_style}\",${_font_weight}},\n")
endforeach()
string(APPEND _iigui_font_header "}};\n}\n")
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/generated")
file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/generated/FontAssets.generated.h" CONTENT "${_iigui_font_header}" @ONLY)
list(APPEND iiGUI_NATIVE_RESOURCE_FILES Pretendard-OFL.txt Inter-OFL.txt)
