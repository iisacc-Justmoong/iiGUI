function(iigui_select_linux_backend requested wayland_available output)
    string(TOUPPER "${requested}" backend)
    if(NOT backend MATCHES "^(AUTO|WAYLAND|X11)$")
        message(FATAL_ERROR "IIGUI_LINUX_BACKEND must be WAYLAND, AUTO or deprecated X11")
    endif()
    if(backend STREQUAL "X11")
        message(DEPRECATION "The iiGUI X11 backend is deprecated; use Wayland for Linux applications")
        set(${output} X11 PARENT_SCOPE)
        return()
    endif()
    if(NOT wayland_available)
        message(FATAL_ERROR "The Wayland host requires wayland-client, wayland-cursor and xkbcommon development packages; AUTO no longer falls back to X11")
    endif()
    set(${output} WAYLAND PARENT_SCOPE)
endfunction()
