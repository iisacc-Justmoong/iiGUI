if(NOT IIGUI_LVUI_COMPILER OR NOT IIGUI_LVUI_SOURCE OR NOT IIGUI_LVUI_OUTPUT OR
   NOT IIGUI_LVUI_NAME MATCHES "^[A-Za-z][A-Za-z0-9_]*$")
    message(FATAL_ERROR "LVUI compiler, source, output and valid generated name are required")
endif()
set(_args --view-factory --name "${IIGUI_LVUI_NAME}" --framework iiGUI)
foreach(_header IN LISTS IIGUI_LVUI_INCLUDES)
    list(APPEND _args --include "${_header}")
endforeach()
foreach(_mode IN LISTS IIGUI_LVUI_STYLE_MODES)
    list(APPEND _args --style-mode "${_mode}")
endforeach()
if(IIGUI_LVUI_STYLE_FILE)
    list(APPEND _args --style-file "${IIGUI_LVUI_STYLE_FILE}")
endif()
set(_temporary "${IIGUI_LVUI_OUTPUT}.iigui-tmp")
execute_process(COMMAND "${IIGUI_LVUI_COMPILER}" ${_args} "${IIGUI_LVUI_SOURCE}"
    RESULT_VARIABLE _result OUTPUT_FILE "${_temporary}" ERROR_VARIABLE _diagnostic)
if(NOT "${_result}" STREQUAL "0")
    file(REMOVE "${_temporary}")
    message(FATAL_ERROR "LVUI AOT compilation failed (${_result}):\n${_diagnostic}")
endif()
if(EXISTS "${IIGUI_LVUI_OUTPUT}")
    file(SHA256 "${IIGUI_LVUI_OUTPUT}" _existing_hash)
    file(SHA256 "${_temporary}" _new_hash)
    if(_existing_hash STREQUAL _new_hash)
        file(REMOVE "${_temporary}")
        return()
    endif()
endif()
file(RENAME "${_temporary}" "${IIGUI_LVUI_OUTPUT}" RESULT _rename)
if(NOT _rename STREQUAL "0")
    file(REMOVE "${_temporary}")
    message(FATAL_ERROR "Cannot publish LVUI generated C++: ${_rename}")
endif()
