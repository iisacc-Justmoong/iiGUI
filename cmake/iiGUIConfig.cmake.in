@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(plutovg CONFIG HINTS "${PACKAGE_PREFIX_DIR}")
find_dependency(lunasvg 3.5.0 EXACT CONFIG HINTS "${PACKAGE_PREFIX_DIR}")
find_dependency(iiSDKCore 0.16 CONFIG COMPONENTS Runtime)
find_dependency(LVUI 0.1 CONFIG)
find_dependency(Vulkan 1.1)
if("@CMAKE_SYSTEM_NAME@" STREQUAL "Linux")
    find_dependency(X11 COMPONENTS Xi)
    find_dependency(PkgConfig)
    pkg_check_modules(NativeGraphics REQUIRED IMPORTED_TARGET pangocairo)
    pkg_check_modules(NativeDesktop REQUIRED IMPORTED_TARGET gio-2.0)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/iiGUITargets.cmake")
set(iiGUI_NATIVE_ABI_ID "@iiGUI_NATIVE_ABI_ID@")
get_filename_component(_iigui_prefix "${CMAKE_CURRENT_LIST_DIR}/../../../" ABSOLUTE)
set(iiGUI_NATIVE_RESOURCES)
foreach(_asset Pretendard-Regular.ttf Pretendard-Medium.ttf Pretendard-SemiBold.ttf Pretendard-Bold.ttf Pretendard-OFL.txt Inter-Regular.ttf Inter-OFL.txt)
    list(APPEND iiGUI_NATIVE_RESOURCES "${_iigui_prefix}/share/iiGUI/resources/native/${_asset}")
endforeach()
check_required_components(iiGUI)
