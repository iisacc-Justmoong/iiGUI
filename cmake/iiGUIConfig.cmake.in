@PACKAGE_INIT@
include("${CMAKE_CURRENT_LIST_DIR}/iiGUILvui.cmake")
if(EMSCRIPTEN AND @BUILD_SHARED_LIBS@)
    # Emscripten's CMake toolchain defaults to static libraries even when the
    # installed SDK was deliberately built as a WebAssembly side module.
    set_property(GLOBAL PROPERTY TARGET_SUPPORTS_SHARED_LIBS TRUE)
endif()
include(CMakeFindDependencyMacro)
# The bundled codecs are siblings of this package, including when the
# consumer's cross-compilation root excludes the SDK installation prefix.
set(_iigui_cmake_packages "${CMAKE_CURRENT_LIST_DIR}/..")
if(NOT plutovg_DIR AND EXISTS "${_iigui_cmake_packages}/plutovg/plutovgConfig.cmake")
    find_dependency(plutovg CONFIG PATHS "${_iigui_cmake_packages}/plutovg" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
else()
    find_dependency(plutovg CONFIG HINTS "${PACKAGE_PREFIX_DIR}")
endif()
if(NOT lunasvg_DIR AND EXISTS "${_iigui_cmake_packages}/lunasvg/lunasvgConfig.cmake")
    find_dependency(lunasvg 3.5.0 EXACT CONFIG PATHS "${_iigui_cmake_packages}/lunasvg" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
else()
    find_dependency(lunasvg 3.5.0 EXACT CONFIG HINTS "${PACKAGE_PREFIX_DIR}")
endif()
unset(_iigui_cmake_packages)
find_dependency(iiSDKCore 0.16 CONFIG COMPONENTS Runtime)
find_dependency(iiGUIPainter 0.5 CONFIG
    PATHS "${CMAKE_CURRENT_LIST_DIR}/../iiGUIPainter" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
if(NOT "@CMAKE_SYSTEM_NAME@" STREQUAL "Emscripten")
    find_dependency(Vulkan 1.1)
endif()
if("@CMAKE_SYSTEM_NAME@" STREQUAL "Linux")
    find_dependency(PkgConfig)
    if("@IIGUI_LINUX_BACKEND@" STREQUAL "WAYLAND")
        pkg_check_modules(Wayland REQUIRED IMPORTED_TARGET wayland-client>=1.20 wayland-cursor>=1.20 xkbcommon>=1.0)
    else()
        if("@IIGUI_HAS_XRANDR@" STREQUAL "ON")
            find_dependency(X11 COMPONENTS Xi Xrandr)
        else()
            find_dependency(X11 COMPONENTS Xi)
        endif()
    endif()
    pkg_check_modules(NativeGraphics REQUIRED IMPORTED_TARGET pangocairo)
    pkg_check_modules(NativeFonts REQUIRED IMPORTED_TARGET fontconfig pangoft2)
    pkg_check_modules(NativeDesktop REQUIRED IMPORTED_TARGET gio-2.0)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/iiGUITargets.cmake")
set(iiGUI_HOST_BACKEND "@iiGUI_HOST_BACKEND@")
set(iiGUI_NATIVE_ABI_ID "@iiGUI_NATIVE_ABI_ID@")
get_filename_component(_iigui_prefix "${CMAKE_CURRENT_LIST_DIR}/../../../" ABSOLUTE)
set(iiGUI_NATIVE_RESOURCES)
set(iiGUI_NATIVE_RESOURCE_FILES "@iiGUI_NATIVE_RESOURCE_FILES@")
foreach(_asset IN LISTS iiGUI_NATIVE_RESOURCE_FILES)
    list(APPEND iiGUI_NATIVE_RESOURCES "${_iigui_prefix}/share/iiGUI/resources/native/${_asset}")
endforeach()
check_required_components(iiGUI)
