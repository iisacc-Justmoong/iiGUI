include("${HELPER}")
if(MODE STREQUAL "override")
    set(FETCHCONTENT_SOURCE_DIR_LUNASVG "explicit-source")
endif()
set(result "stale-source")
iigui_svg_source(result "${ROOT}")
if(MODE STREQUAL "missing" AND result)
    message(FATAL_ERROR "Missing source must not be reused")
elseif(MODE STREQUAL "valid" AND NOT result STREQUAL "${ROOT}/resources/dependencies/lunasvg")
    message(FATAL_ERROR "Existing source must be reused")
elseif(MODE STREQUAL "override" AND NOT result STREQUAL "explicit-source")
    message(FATAL_ERROR "Explicit source must win")
endif()
