# Assert the first-party Apache-2.0 grant, notice, and package metadata.
if(NOT DEFINED SOURCE)
    message(FATAL_ERROR "Missing SOURCE")
endif()

file(READ "${SOURCE}/LICENSE" _license)
if(NOT _license MATCHES "Apache License")
    message(FATAL_ERROR "LICENSE is missing the Apache License title")
endif()
if(NOT _license MATCHES "Version 2\\.0, January 2004")
    message(FATAL_ERROR "LICENSE is missing Apache License Version 2.0")
endif()
if(NOT _license MATCHES "http://www\\.apache\\.org/licenses/")
    message(FATAL_ERROR "LICENSE is missing the Apache license URL")
endif()
if(NOT _license MATCHES "END OF TERMS AND CONDITIONS")
    message(FATAL_ERROR "LICENSE is missing the Apache terms")
endif()
if(_license MATCHES "MIT License")
    message(FATAL_ERROR "LICENSE still contains an MIT License claim")
endif()

file(READ "${SOURCE}/NOTICE" _notice)
if(NOT _notice MATCHES "Copyright \\(c\\) 2026 iisacc")
    message(FATAL_ERROR "NOTICE is missing Copyright (c) 2026 iisacc")
endif()
if(NOT _notice MATCHES "Apache License")
    message(FATAL_ERROR "NOTICE does not name the Apache License")
endif()

file(READ "${SOURCE}/README.md" _readme)
if(NOT _readme MATCHES "SPDX-License-Identifier: Apache-2\\.0")
    message(FATAL_ERROR "README SPDX identifier is not Apache-2.0")
endif()
if(_readme MATCHES "SPDX-License-Identifier: MIT")
    message(FATAL_ERROR "README still identifies the module as MIT")
endif()

file(READ "${SOURCE}/docs/License.md" _korean)
if(NOT _korean MATCHES "SPDX-License-Identifier: Apache-2\\.0")
    message(FATAL_ERROR "docs/License.md SPDX identifier is not Apache-2.0")
endif()
if(NOT _korean MATCHES "Copyright \\(c\\) 2026 iisacc")
    message(FATAL_ERROR "docs/License.md is missing the copyright notice")
endif()

file(READ "${SOURCE}/AGENT.md" _agent)
if(NOT _agent MATCHES "Apache License 2\\.0")
    message(FATAL_ERROR "AGENT.md does not state Apache License 2.0")
endif()
if(NOT _agent MATCHES "Copyright \\(c\\) 2026 iisacc")
    message(FATAL_ERROR "AGENT.md is missing the copyright notice")
endif()

file(READ "${SOURCE}/cmake/iiGUIConfig.cmake.in" _gui_config)
if(NOT _gui_config MATCHES "set\\(iiGUI_SPDX_LICENSE \"Apache-2\\.0\"\\)")
    message(FATAL_ERROR "iiGUI package config does not export iiGUI_SPDX_LICENSE")
endif()
file(READ "${SOURCE}/cmake/iiGUIPainterConfig.cmake.in" _painter_config)
if(NOT _painter_config MATCHES "set\\(iiGUIPainter_SPDX_LICENSE \"Apache-2\\.0\"\\)")
    message(FATAL_ERROR "iiGUIPainter package config does not export iiGUIPainter_SPDX_LICENSE")
endif()

file(READ "${SOURCE}/CMakeLists.txt" _cmake)
if(NOT _cmake MATCHES "set\\(iiGUI_SPDX_LICENSE \"Apache-2\\.0\"\\)")
    message(FATAL_ERROR "CMakeLists does not set iiGUI_SPDX_LICENSE")
endif()
if(NOT _cmake MATCHES "set\\(iiGUIPainter_SPDX_LICENSE \"Apache-2\\.0\"\\)")
    message(FATAL_ERROR "CMakeLists does not set iiGUIPainter_SPDX_LICENSE")
endif()
if(NOT _cmake MATCHES "install\\(FILES README.md LICENSE NOTICE")
    message(FATAL_ERROR "CMake install rule does not copy LICENSE")
endif()

file(READ "${SOURCE}/src/third_party/utf8proc/LICENSE.md" _utf8)
if(NOT _utf8 MATCHES "MIT")
    message(FATAL_ERROR "Vendored utf8proc license text was altered")
endif()

message(STATUS "iiGUI Apache-2.0 license files, notices, and package SPDX metadata match")
