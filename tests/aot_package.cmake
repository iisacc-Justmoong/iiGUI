# Reproducible installed-only macOS consumer, including relocation and runtime
# execution with its source and the build-host compiler made unavailable.
foreach(_required SOURCE BUILD_ROOT CORE_PREFIX LVUI_BUILD GUI_BUILD)
    if(NOT DEFINED ${_required})
        message(FATAL_ERROR "Missing ${_required}")
    endif()
endforeach()
cmake_path(ABSOLUTE_PATH BUILD_ROOT NORMALIZE)
cmake_path(ABSOLUTE_PATH GUI_BUILD NORMALIZE)
cmake_path(IS_PREFIX GUI_BUILD "${BUILD_ROOT}" NORMALIZE _inside)
if(NOT _inside OR NOT BUILD_ROOT MATCHES "/build/" OR EXISTS "${BUILD_ROOT}")
    message(FATAL_ERROR "Use a fresh destination inside iiGUI/build/ for BUILD_ROOT")
endif()
set(_stage "${BUILD_ROOT}/stage")
set(_prefix "${BUILD_ROOT}/relocated")
file(MAKE_DIRECTORY "${_stage}")
file(COPY "${CORE_PREFIX}/" DESTINATION "${_stage}")
foreach(_project IN ITEMS "${LVUI_BUILD}" "${GUI_BUILD}")
    execute_process(COMMAND "${CMAKE_COMMAND}" --install "${_project}" --prefix "${_stage}"
        RESULT_VARIABLE _status OUTPUT_VARIABLE _output ERROR_VARIABLE _error)
    if(NOT _status EQUAL 0)
        message(FATAL_ERROR "Staging failed: ${_output}\n${_error}")
    endif()
endforeach()
file(RENAME "${_stage}" "${_prefix}")
file(COPY "${_prefix}/share/iiGUI/examples/HelloWorld/" DESTINATION "${BUILD_ROOT}/source")
set(_clean "${CMAKE_COMMAND}" -E env --unset=CPATH --unset=CPLUS_INCLUDE_PATH --unset=C_INCLUDE_PATH
    --unset=LIBRARY_PATH --unset=LD_LIBRARY_PATH --unset=DYLD_LIBRARY_PATH --unset=DYLD_FALLBACK_LIBRARY_PATH
    --unset=DYLD_FRAMEWORK_PATH --unset=DYLD_FALLBACK_FRAMEWORK_PATH --)
set(_vulkan)
foreach(_variable Vulkan_INCLUDE_DIR Vulkan_LIBRARY)
    file(STRINGS "${GUI_BUILD}/CMakeCache.txt" _line REGEX "^${_variable}:[^=]*=")
    string(REGEX REPLACE "^[^=]*=" "" _value "${_line}")
    list(APPEND _vulkan "-D${_variable}=${_value}")
endforeach()
execute_process(COMMAND ${_clean} "${CMAKE_COMMAND}" -S "${BUILD_ROOT}/source" -B "${BUILD_ROOT}/build" -G Ninja
    "-DCMAKE_PREFIX_PATH=${_prefix}" "-DiiGUI_DIR:PATH=${_prefix}/lib/cmake/iiGUI" "-DLVUI_DIR:PATH=${_prefix}/lib/cmake/LVUI" "-DiiSDKCore_DIR:PATH=${_prefix}/lib/cmake/iiSDKCore" ${_vulkan} -DCMAKE_BUILD_TYPE=Release -DCMAKE_EXPORT_COMPILE_COMMANDS=ON
    -DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF -DCMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY=OFF
    -DCMAKE_DISABLE_FIND_PACKAGE_Qt5=ON -DCMAKE_DISABLE_FIND_PACKAGE_Qt6=ON
    RESULT_VARIABLE _status OUTPUT_VARIABLE _output ERROR_VARIABLE _error)
file(WRITE "${BUILD_ROOT}/configure.log" "${_output}\n${_error}")
if(NOT _status EQUAL 0)
    message(FATAL_ERROR "Installed consumer configuration failed: ${_output}\n${_error}")
endif()
foreach(_package iiGUI LVUI iiSDKCore)
    file(STRINGS "${BUILD_ROOT}/build/CMakeCache.txt" _line REGEX "^${_package}_DIR:PATH=")
    if(NOT _line STREQUAL "${_package}_DIR:PATH=${_prefix}/lib/cmake/${_package}")
        message(FATAL_ERROR "Consumer used a package outside the relocated prefix: ${_line}")
    endif()
endforeach()
execute_process(COMMAND ${_clean} "${CMAKE_COMMAND}" --build "${BUILD_ROOT}/build" --parallel 4
    RESULT_VARIABLE _status OUTPUT_VARIABLE _output ERROR_VARIABLE _error)
file(WRITE "${BUILD_ROOT}/build.log" "${_output}\n${_error}")
if(NOT _status EQUAL 0)
    message(FATAL_ERROR "Installed consumer build failed: ${_output}\n${_error}")
endif()
file(READ "${BUILD_ROOT}/build/compile_commands.json" _commands)
cmake_path(GET SOURCE PARENT_PATH _sdk)
if(_commands MATCHES "${SOURCE}/src" OR _commands MATCHES "${_sdk}/LVUI/src")
    message(FATAL_ERROR "Consumer accessed authoring source headers")
endif()
string(FIND "${_commands}" "${_prefix}/lib/cmake/iiSDKCore/ApplicationEntry.cpp" _core_entry)
if(_core_entry LESS 0)
    message(FATAL_ERROR "Final executable did not compile the installed Core entrypoint")
endif()
foreach(_font Pretendard-Regular.ttf Pretendard-Medium.ttf Pretendard-SemiBold.ttf Pretendard-Bold.ttf Inter-Regular.ttf)
    file(SHA256 "${_prefix}/share/iiGUI/resources/native/${_font}" _installed_hash)
    file(SHA256 "${BUILD_ROOT}/build/HelloWorld.app/Contents/Resources/${_font}" _bundle_hash)
    if(NOT _installed_hash STREQUAL _bundle_hash)
        message(FATAL_ERROR "Core did not attach the unmodified native font resource ${_font}")
    endif()
endforeach()
set(_binary "${BUILD_ROOT}/build/HelloWorld.app/Contents/MacOS/HelloWorld")
execute_process(COMMAND /usr/bin/otool -L "${_binary}" RESULT_VARIABLE _status OUTPUT_VARIABLE _libraries)
if(NOT _status EQUAL 0 OR _libraries MATCHES "Qt[0-9A-Za-z]*\\.framework|libQt|QtCore|QtGui|QtWidgets")
    message(FATAL_ERROR "Binary dependency audit failed: ${_libraries}")
endif()
file(WRITE "${BUILD_ROOT}/dependencies.txt" "${_libraries}")
execute_process(COMMAND /usr/bin/nm -j "${_binary}" RESULT_VARIABLE _status OUTPUT_VARIABLE _symbols)
if(NOT _status EQUAL 0 OR _symbols MATCHES "_ZN4lvui[0-9]")
    message(FATAL_ERROR "Runtime binary contains LVUI compiler/parser symbols")
endif()
file(WRITE "${BUILD_ROOT}/symbols.txt" "${_symbols}")
if(_symbols MATCHES "OBJC_CLASS_.*(NSButton|NSTextField|NSStackView|NSControl|NSColorWell|NSColorPanel)")
    message(FATAL_ERROR "OS control class linked by a self-rendered widget app")
endif()
file(RENAME "${BUILD_ROOT}/source" "${BUILD_ROOT}/source.offline")
file(RENAME "${_prefix}/bin/lvui-compile" "${_prefix}/bin/lvui-compile.offline")
file(RENAME "${_prefix}/lib/cmake/iiSDKCore/ApplicationEntry.cpp" "${_prefix}/lib/cmake/iiSDKCore/ApplicationEntry.cpp.offline")
execute_process(COMMAND ${_clean} "${CMAKE_CTEST_COMMAND}" --test-dir "${BUILD_ROOT}/build" --output-on-failure
    --output-junit "${BUILD_ROOT}/tests.xml"
    RESULT_VARIABLE _status OUTPUT_VARIABLE _output ERROR_VARIABLE _error)
file(WRITE "${BUILD_ROOT}/runtime.log" "${_output}\n${_error}")
# Restore only test-owned sources/tools so the delivered consumer remains editable.
file(RENAME "${BUILD_ROOT}/source.offline" "${BUILD_ROOT}/source")
file(RENAME "${_prefix}/bin/lvui-compile.offline" "${_prefix}/bin/lvui-compile")
file(RENAME "${_prefix}/lib/cmake/iiSDKCore/ApplicationEntry.cpp.offline" "${_prefix}/lib/cmake/iiSDKCore/ApplicationEntry.cpp")
if(NOT _status EQUAL 0)
    message(FATAL_ERROR "Source-free installed app execution failed: ${_output}\n${_error}")
endif()
file(WRITE "${BUILD_ROOT}/verification.json"
    "{\n  \"native_backend\": \"iiGUI/Metal\",\n  \"application_runtime\": \"iiSDKCore\",\n  \"core_entry_compiled\": true,\n  \"cpp_widget_instance\": true,\n  \"lvrs_font_resources_attached\": true,\n  \"relocated_packages\": [\"iiSDKCore\", \"LVUI\", \"iiGUI\"],\n  \"source_and_compiler_offline_at_execution\": true,\n  \"qt_linked\": false,\n  \"lvui_parser_symbols\": false,\n  \"os_control_class_symbols\": false,\n  \"self_rendered_widgets\": true,\n  \"consumer_ctest_passed\": true\n}\n")
message(STATUS "${_output}")
message(STATUS "AOT_INSTALLED_CONSUMER_OK relocated=${_prefix}; source/compiler offline; Qt/parser absent")
