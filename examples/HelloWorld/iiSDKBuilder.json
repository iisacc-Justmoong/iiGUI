    {"id": "macos", "platform": "macos", "cache": {"CMAKE_DISABLE_FIND_PACKAGE_Qt5": "ON", "CMAKE_DISABLE_FIND_PACKAGE_Qt6": "ON", "CMAKE_DISABLE_FIND_PACKAGE_iiFileProviderNative": "ON", "CMAKE_DISABLE_FIND_PACKAGE_iiFileProviderCoreIO": "ON"}}
  ]
