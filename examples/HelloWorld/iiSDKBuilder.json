    {"name": "iiColorManager", "source": "../../../iiColorManager", "cache": {"BUILD_SHARED_LIBS": "OFF", "BUILD_TESTING": "OFF"}},
    {"name": "LVUI", "source": "../../../LVUI", "depends": ["iiSDKCore", "iiColorManager"], "cache": {"BUILD_TESTING": "OFF"}},
    {"name": "iiGUI", "source": "../..", "depends": ["iiSDKCore"], "cache": {"BUILD_SHARED_LIBS": "OFF", "BUILD_TESTING": "OFF", "IIGUI_BUILD_EXAMPLES": "OFF"}}
