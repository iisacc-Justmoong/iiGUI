{
  "schema": 1,
  "app": {
    "name": "HelloWorld",
    "source": ".",
    "depends": ["LVUI", "iiGUI"],
    "cache": {"BUILD_TESTING": "ON"},
    "targets": ["HelloWorld"]
  },
  "sdkRoot": "../../..",
